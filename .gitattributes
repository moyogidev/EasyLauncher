# Normalize line endings: store text as LF in the repo, check out native on each OS.
* text=auto

# Source and config files — always LF in the repo.
*.kt        text eol=lf
*.java      text eol=lf
*.kts       text eol=lf
*.gradle    text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.properties text eol=lf
*.pro       text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.cfg       text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Gradle wrapper scripts — the shell script must stay LF, the batch file CRLF.
gradlew     text eol=lf
*.sh        text eol=lf
gradlew.bat text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary assets — never touch these.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.jar       binary
*.aar       binary
*.apk       binary
*.aab       binary
*.keystore  binary
*.jks       binary
